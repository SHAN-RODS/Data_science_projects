  "regulations": [
  {
      "unique_id": "WAL-R1",
      "regulation_name": "Means of escape",   
      "description": "Each floor should have 4.5m above ground level and should have a protected stairway.",
      "ifc_element": ["IfcSpace","IfcStair","IfcBuildingStorey"],
      "ifc_attribute_involved": "elevation",
      "threshold_mark": 4.5,
      "comparison": "gte",
      "unit": "m",
      "applies_to": "Storey",
      "severity_level": "critical",
      "doc_reference": "Section 3 Paragraph 3.6"
    },
    
    {
      "unique_id": "WAL-R2",
      "regulation_name": "Floor level above ground level should have an escape route",   
      "description": "The storey level should be greater than 7.5m above the ground level",
      "ifc_element": ["IfcSpace","IfcBuildingStorey"],
      "ifc_attribute_involved": "elevation_m",
      "threshold_mark": 7.5,
      "comparison": "gte",
      "unit": "m",
      "applies_to": "doors",
      "severity_level": "high",
      "doc_reference": "Section 3 Paragraph 3.9-3.13"
    },

    {
      "unique_id": "WAL-R3",
      "regulation_name": "Emergency Windows",   
      "description": "The emergency window should have an unobstructable area that should be 0.33m.",
      "ifc_element": "IfcWindow",
      "ifc_attribute_involved": "clear_area",
      "threshold_mark": 0.33,
      "comparison": "gte",
      "unit": "m2",
      "applies_to": "windows",
      "severity_level": "critical",
      "doc_reference": "Section 3 Paragraph 3.8" 
    },
    {
      "unique_id": "WAL-R4",
      "regulation_name": "Automatic fire suppression system",   
      "description": "The fire suppression system should be present in all the residential buildings and cover the entire building.",
      "ifc_element": "IfcFireSuppressionTerminal",
      "ifc_attribute_involved": "count",
      "threshold_mark": 1,    
      "comparison": "gte",
      "unit": "null",
      "applies_to": "building",
      "severity_level": "high",
      "doc_reference": "Section 2 Paragraph 2.2- 2.4,Regulation 37A"
    },
    {
      "unique_id": "WAL-R5",  
      "regulation_name": "Emergency window height",   
      "description": "The emergency window should have an unobstructable area that should be 0.33m and 450mm high and 450m wide.",
      "ifc_element": "IfcSpace",
      "ifc_attribute_involved": "window_height",
      "threshold_mark": {"min": 800, "max": 1100 } ,
      "comparison": "gte",
      "unit": "mm",
      "applies_to": "windows",
      "severity_level": "critical",
      "doc_reference": "Section 3 Paragraph 3.8"
    },
    {
      "unique_id": "WAL-R6",
      "regulation_name": "Basement escape route",   
      "description": "The basement storey that contains any habituable room should have an external door or window ro a protected stairway leading to the final exit.",
      "ifc_element": "IfcWindow",
      "ifc_attribute_involved": "external_basement",
      "threshold_mark": 1,
      "comparison": "gte",
      "unit": "null",
      "applies_to": "basement",
      "severity_level": "medium",
      "doc_reference": "Section 3 Paragraph 3.13"
    },
    {
      "unique_id": "WAL-R7",
      "regulation_name": "Escape stairs width",   
      "description": "The external escape stair must have a clear width of 1800mm from the stairs to the place of safety.",
      "ifc_element": "IfcStairFlight",
      "ifc_attribute_involved": "width_m",
      "threshold_mark": 1800,
      "comparison": "gte",
      "unit": "mm",
      "applies_to": "stairs",
      "severity_level": "critical",
      "doc_reference": "Section 3 Paragraph 3.15"
    },
    {
      "unique_id": "WAL-R8",
      "regulation_name": "Passenger Lift",   
      "description": "When there is a passenger lift having a storey more than 4.5m above ground level, it should be located near the protected stairway.",
