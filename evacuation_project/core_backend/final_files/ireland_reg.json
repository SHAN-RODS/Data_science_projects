{
  "jurisdiction": "Northern Ireland",
  "document_source": "Northern Ireland Technical Booklet E (2012).", 
  "regulations": [
  {
      "unique_id": "NI-R1",
      "regulation_name": "Means of escape from storey building",   
      "description": "The common provisions will be applied if no storey is more than 4.5m above the ground level.",
      "ifc_element": "IfcBuildingStorey",
      "ifc_attribute_involved": "elevation",
      "threshold_mark": 4.5,
      "comparison": "gte",
      "unit": "m",
      "applies_to": "storeys",
      "severity_level": "low",
      "doc_reference": "Section 2, Paragraph 2.2"
    },
    
    {
      "unique_id": "NI-R2",
      "regulation_name": "Single Storey with protected stairway",   
      "description": "When the storey will exceed the 4.5m level, the final storey should have a protected stairway to escape.",
      "ifc_element": "IfcDoor",
      "ifc_attribute_involved": "is_emergency_exit",
      "threshold_mark": 1,
      "comparison": "gte",
      "unit": "null",
      "applies_to": "stairs",
      "severity_level": "medium",
      "doc_reference": "Section 2, Paragraph 2.2"
    },

    {
      "unique_id": "NI-R3",
      "regulation_name": "Emergency escape windows",   
      "description": "The emergency escape window should have a clear opening that is not less than 0.33 m².",
      "ifc_element": "IfcWindow",
      "ifc_attribute_involved": "area_m2",
      "threshold_mark": 0.33,
      "comparison": "gte",
      "unit": "m²",
      "applies_to": "doors",
      "severity_level": "critical",
      "doc_reference": "Section 2, Paragraph 2.9" 
    },
    {
      "unique_id": "NI-R4",
      "regulation_name": "Minimum Escape window width",   
      "description": "The emergency window width should be at least 450mm wide.",
      "ifc_element": "IfcWindow",
      "ifc_attribute_involved": "width_mm",
      "threshold_mark": 450,
      "comparison": "gte",    
      "unit": "mm",
      "applies_to": "stair",
      "severity_level": "critical",
      "doc_reference": "Section 2, Paragraph 2.9"
    },
    {
      "unique_id": "NI-R5",  
      "regulation_name": "Emergency window height",   
      "description": "The lower edge of the window opening should be not less than 800 mm and not more than 1100 mm above the floor level.",
      "ifc_element": "IfcSpace",
      "ifc_attribute_involved": "height_mm",
      "threshold_mark": {"min": 800, "max": 1100},
      "comparison": "gte",
      "unit": "mm",
      "applies_to": "windows",
      "severity_level": "critical",
      "doc_reference": "Section 2, Paragraph 2.9"
    },
    {
      "unique_id": "NI-R6",
      "regulation_name": "Basement escape route",   
      "description": "The basement storey containing a habituable room should be served by a protected stairway that leads to the final exit.",
      "ifc_element": "IfcSpace",
      "ifc_attribute_involved": "protected_stairway",
      "threshold_mark": 1,
      "comparison": "gte",
      "unit": "null",
      "applies_to": "basement_spaces",
      "severity_level": "critical",
      "doc_reference": "Section 2, Paragraph 2.4"
    },
    {
      "unique_id": "NI-R7",
      "regulation_name": "Smoke alarm presence and the distance to the nearest door",   
      "description": "The smoke alarms should be located not more than 3m from the bedroom door and 7.5m from the living to the kitchen door.",
      "ifc_element": "IfcAlarm",
      "ifc_attribute_involved": "distance_door.",
      "threshold_mark": {"bed_door": 0.3, "living_kitchen_door": 7.5},
      "comparison": "gte",
      "unit": "m",
      "applies_to": "alarms",
      "severity_level": "major",
      "doc_reference": "Section 2,Paragraph 2.27"
    },
    {
      "unique_id": "NI-R8",
      "regulation_name": "Fire detection for all the storeys",   
      "description": "The total number of storeys is more than 200m2 and should be provided with an automatic fire and alarm detection system complying with BS-5839-6.",
      "ifc_element": "IfcSpace",
      "ifc_attribute_involved": "area_m2",
      "threshold_mark": 200,
      "comparison": "gte",
      "unit": "m2",
      "applies_to": "storey_spaces",
      "severity_level": "critical",
      "doc_reference": "Section 2, Paragraph 2.24"
    },
    {
      "unique_id": "NI-R9",
      "regulation_name": "Necessity of Passenger lifts",   
      "description": "When there is a passenger lift provided, it should have a storey more than 4.5m above ground level, it should be located near the protected stairway or fire-resisting lift shaft.",
      "ifc_element": "IfcTransportElement",
      "ifc_attribute_involved": "passenger_lift",
      "threshold_mark": 1,
      "comparison": "gte",
      "unit": "null",
      "applies_to": "lifts",
      "severity_level": "critical",
      "doc_reference": "Section 2, Paragraph 2.16"
    },
    {
      "unique_id": "NI-R10",
      "regulation_name": "Construction of all possible escape stairs in the buildings.",   
      "description": "The escape stairs are made such that it should serve the height of the storey and be more than 18m above the ground or final exit level.",
      "ifc_element": "IfcStair",
      "ifc_attribute_involved": "escape_stairs",
      "threshold_mark": 18,
      "comparison": "gte",
      "unit": "m",
      "applies_to": "stairs",
      "severity_level": "critical",
      "doc_reference": "Section 2, Paragraph 2.93"
    }
  ]

}